server_tokens off;
# Redirects keep the client's host and port, not the container's 8080/8443
absolute_redirect off;
tcp_nopush on;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
    text/css
    text/plain
    text/xml
    application/javascript
    application/json
    application/xml
    image/svg+xml;

resolver 127.0.0.11 valid=10s ipv6=off;

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=email:10m rate=1r/m;
limit_req_status 429;

map $uri $content_security_policy {
    ~^/api/(docs|swagger|redoc)$ "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com https://fonts.scalar.com; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.jsdelivr.net https://cdn.redoc.ly; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
    default "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
}

upstream api {
    zone api 64k;
    server api:8000 resolve;
    keepalive 16;
}

upstream frontend {
    zone frontend 64k;
    server frontend:8080 resolve;
    keepalive 16;
}

server {
    listen 8080 default_server;
    server_name _;
    return 444;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 8080;
    server_name ${DOMAIN} ${DOMAIN_ALIASES};

    include /etc/nginx/conf.d/tls.in[c];

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy $content_security_policy always;
    add_header Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()" always;

    if ($host != ${DOMAIN}) {
        return 301 $scheme://${DOMAIN}$request_uri;
    }

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ~ ^/api/(auth/signup|auth/password/forgot|users/me/activate/resend)$ {
        limit_req zone=email burst=5 nodelay;
        proxy_pass http://api;
    }

    location /api/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://api;
    }

    location = /api/users/me/activate {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://api;
    }

    location /api/ {
        proxy_pass http://api;
    }

    location /assets/ {
        expires max;
        proxy_pass http://frontend;
    }

    location / {
        expires epoch;
        proxy_pass http://frontend;
    }
}
