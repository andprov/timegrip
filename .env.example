# APP
DEBUG=False
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGIN=http://localhost:3000

# DB
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=timegrip
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ECHO=False

# JWT
SECRET_KEY=<secret_key_value>
EXPIRE_TIME=15
ALGORITHM=HS256

# SMTP
# EMAIL_SENDER_BACKEND=smtp - default
# EMAIL_SENDER_BACKEND=console logs emails instead of sending them via SMTP
# (useful for local/manual testing)
EMAIL_SENDER_BACKEND=smtp
SMTP_HOST=<smtp_host_value>
# Port 465 (implicit TLS) -> SMTP_USE_TLS=True
# Port 587 (STARTTLS)     -> SMTP_USE_TLS=False
SMTP_PORT=465
SMTP_USERNAME=<smtp_username_value>
SMTP_PASSWORD=<smtp_password_value>
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=<smtp_from_email_value>
# Sender display name shown in mail clients, default TimeGrip
SMTP_FROM_NAME=TimeGrip

# DEPLOY (docker-compose.yml: HTTPS via nginx + Let's Encrypt)
# Main domain: nginx server_name, the certificate name and links in emails
DOMAIN=example.com
# Extra names, space-separated: added to the certificate and redirected to
# DOMAIN; leave empty for none
DOMAIN_ALIASES=www.example.com
# Let's Encrypt account contact; may be left empty
CERTBOT_EMAIL=admin@example.com
# True issues an untrusted test certificate from the Let's Encrypt staging
# server (no rate limits) - use it for the first attempts on a new server
CERTBOT_STAGING=False
# SEO config for the frontend build, default ./frontend/seo.config.json;
# /dev/null builds without SEO tags
# SEO_CONFIG_FILE=/dev/null
